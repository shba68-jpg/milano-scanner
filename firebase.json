{
  "hosting": {
    "site": "milano-scanner",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/download/**",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/download/**",
        "destination": "/download/app-debug.apk"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
